# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MariaDB
DB_NAME=abstergo
DB_USER=abstergo
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Localización
LANGUAGE_CODE=es
TIME_ZONE=America/Santiago

# Correo. En desarrollo se usa la consola; en el EC2 se cambia a el backend SMTP.
MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@muniserena.cl

# Autenticación
OTP_EXPIRY_MINUTES=10
OTP_REENVIO_SEGUNDOS=45
PASSWORD_MIN_LENGTH=8
USUARIOS_PASSWORD_INICIAL=

# API
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
API_PAGE_SIZE=20
